# Application
SECRET_KEY=generate-a-32-char-random-string-here
DEBUG=false

# Database (SQLite for dev, PostgreSQL URL for prod)
DATABASE_URL=sqlite+aiosqlite:///./data/oldmoney.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/oldmoney

# AI Provider (ollama is default, no API key needed)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: cloud AI fallback
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side Next.js rewrite target for /api/v1/* proxying
# (preferred over NEXT_PUBLIC_API_URL when set)
API_ORIGIN=http://localhost:8000
